{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GS-P001-DOC-013",
  "title": "GS-P001 Software Source Register",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["software_record_id", "source_id", "product_name", "publisher", "platform", "record_type", "canonical_url", "retrieved_at", "independence_status", "verification_status"],
    "properties": {
      "software_record_id": {"type": "string", "pattern": "^GS-P001-SW-[0-9]{4}$"},
      "source_id": {"type": "string", "pattern": "^GS-P001-SRC-[0-9]{4}$"},
      "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^GS-P001-EV-[0-9]{4}$"}, "uniqueItems": true},
      "product_name": {"type": "string", "minLength": 1},
      "publisher": {"type": "string", "minLength": 1},
      "platform": {"type": "string", "enum": ["app_store", "google_play", "g2", "capterra", "trustpilot", "bbb", "vendor_forum", "other"]},
      "record_type": {"type": "string", "enum": ["user_review", "complaint", "support_thread", "release_note", "vendor_documentation", "other"]},
      "canonical_url": {"type": "string", "format": "uri"},
      "published_at": {"type": ["string", "null"], "format": "date-time"},
      "retrieved_at": {"type": "string", "format": "date-time"},
      "independence_status": {"type": "string", "enum": ["independent", "partially_independent", "vendor_controlled", "unknown"]},
      "verification_status": {"type": "string", "enum": ["verified", "pending_verification", "rejected", "unavailable"]},
      "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "archived_copy_path": {"type": "string", "minLength": 1},
      "notes": {"type": ["string", "null"]}
    }
  }
}
